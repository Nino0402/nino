# ── Cookie browser ─────────────────────────────────────────────────────────
# Copiază valoarea header-ului Cookie din DevTools (F12 → Network → orice request → Headers)
REBS_COOKIE=session=abc123; other_cookie=xyz

# ── URL cu filtrele tale ────────────────────────────────────────────────────
# Deschide CRM-ul, aplică filtrele dorite, copiază URL-ul din browser
REBS_URL=https://mervani-imobiliare.crmrebs.com/market-snapshot/listings?filter1=...

# ── Google Sheets ───────────────────────────────────────────────────────────
DELIVER_SHEETS=1
GOOGLE_SA_JSON=/home/user/nino/service_account.json
# ID-ul din URL: https://docs.google.com/spreadsheets/d/ACESTA_ESTE_ID/edit
SHEETS_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# ── Alerte Telegram ─────────────────────────────────────────────────────────
# 1. Scrie /newbot la @BotFather → primești TOKEN
# 2. Adaugă botul în grupul tău sau scrie-i un mesaj
# 3. Accesează https://api.telegram.org/bot<TOKEN>/getUpdates → copiază "chat":{"id":...}
TELEGRAM_TOKEN=123456789:ABCdefGhIjKlMnOpQrStUvWxYz
TELEGRAM_CHAT_ID=-100123456789

# ── Email (opțional) ────────────────────────────────────────────────────────
# DELIVER_EMAIL=1
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tine@gmail.com
# SMTP_PASS=parola_aplicatie_gmail
# MAIL_TO=destinatar@gmail.com

# ── Google Drive (opțional) ─────────────────────────────────────────────────
# DELIVER_DRIVE=1
# DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOp
